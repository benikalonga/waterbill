PORT=4000
NODE_ENV=development
# Origin of the web app (CORS)
WEB_URL=http://localhost:3000

DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:3306/waterbill"

# Two different random strings of 32+ characters: openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# SMS gateway (Twilio). Without these, messages are printed to the console outside production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Shared secrets for inbound integrations: openssl rand -hex 32
# Payment operators send X-Webhook-Secret; smart meter gateways send X-Device-Key.
PAYMENT_WEBHOOK_SECRET=
METER_GATEWAY_KEY=
