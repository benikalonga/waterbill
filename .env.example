# Used by docker-compose.yml. Copy to .env and fill in every secret.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Two different values: openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=
METER_GATEWAY_KEY=

# Public addresses
WEB_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com
CURRENCY=USD

# SMS (optional in development)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
